# Preparation template only. No mainnet deployment/transactions are authorized.
# Use a separate service/data volume/signing keys; do not reuse devnet content.
# Clear the Docker image's devnet-only historical bootstrap.
AGENTBOND_HISTORY_FILE=
AGENTBOND_NETWORK=mainnet-beta
AGENTBOND_ENABLE_MAINNET=false
AGENTBOND_RPC_URL=https://api.mainnet-beta.solana.com
AGENTBOND_GENESIS_HASH=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
AGENTBOND_PROGRAM_ID=REPLACE_WITH_DEPLOYED_MAINNET_PROGRAM
AGENTBOND_MINT=REPLACE_WITH_SUPPORTED_MAINNET_SPL_MINT
AGENTBOND_VERIFIER=REPLACE_WITH_MAINNET_VERIFIER_WALLET
AGENTBOND_DECIMALS=6
AGENTBOND_PUBLIC_API_URL=REPLACE_WITH_PUBLIC_HTTPS_API
AGENTBOND_WEB_ORIGIN=REPLACE_WITH_PUBLIC_HTTPS_ORIGIN
AGENTBOND_AUTH_DOMAIN=REPLACE_WITH_PUBLIC_HOST
AGENTBOND_DATA_DIR=/data
AGENTBOND_KEY_DIR=/run/agentbond
PORT=4100
# No faucet or demo-mint-authority credential may be configured on mainnet.
